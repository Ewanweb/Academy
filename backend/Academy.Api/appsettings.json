{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AcademyDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Issuer": "PardisTousAcademy",
    "Audience": "PardisTousAcademy",
    "Key": "VeryStrong_SecretKey_ForJwt_PardisTousAcademy_ChangeMe",
    "ExpiresInMinutes": 120
  },
  "SiteSettings": {
    "BaseUrl": "http://localhost:5000"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
